# --- KOPIER DENNE FILEN TIL .env OG FYLL INN EKTE VERDIER ---
# .env-filen skal ALDRI commitsjes til Git (er allerede i .gitignore)

# Server
PORT=3000
BASE_URL=https://din-server.no
NODE_ENV=production

# Vipps eCom (https://portal.vipps.no)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_BASE_URL=https://api.vipps.no
CALLBACK_URL=https://din-server.no/api/booking/vipps-callback

# iglohome (https://igloocompany.co)
IGLOHOME_API_KEY=
IGLOHOME_API_SECRET=
IGLOHOME_DEVICE_ID=

# SMS-leverandør (LinkMobility eller Twilio)
SMS_API_KEY=

# Admin
ADMIN_TELEFON=4700000000
ADMIN_TOKEN=lang-tilfeldig-streng-her-minst-32-tegn

# --- TIPS: Generer ADMIN_TOKEN slik ---
# I terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
