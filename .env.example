# --- KOPIER DENNE FILEN TIL .env OG FYLL INN EKTE VERDIER ---
# .env-filen skal ALDRI commitsjes til Git (er allerede i .gitignore)

# Server
PORT=3000
BASE_URL=https://din-server.no
NODE_ENV=production

# Vipps eCom (https://portal.vipps.no)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
VIPPS_BASE_URL=https://api.vipps.no

# Vipps legger selv til "/v2/payments/{orderId}" på dette prefikset.
# Settes automatisk til <BASE_URL>/api/booking/vipps hvis den står tom.
VIPPS_CALLBACK_PREFIX=

# Hemmelig streng som sendes til Vipps ved betalingsstart og kommer tilbake i
# Authorization-headeren på callbacken. Generer med kommandoen nederst i fila.
VIPPS_CALLBACK_TOKEN=

# iglohome (https://igloocompany.co)
IGLOHOME_API_KEY=
IGLOHOME_API_SECRET=
IGLOHOME_DEVICE_ID=

# SMS-leverandør (LinkMobility eller Twilio)
SMS_API_KEY=

# Admin
ADMIN_TELEFON=4700000000
ADMIN_TOKEN=lang-tilfeldig-streng-her-minst-32-tegn

# --- TIPS: Generer ADMIN_TOKEN og VIPPS_CALLBACK_TOKEN slik ---
# I terminal: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
